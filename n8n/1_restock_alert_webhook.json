{
  "name": "RestockPilot 1 - Restock alert (Slack, email, SMS)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "restock-alert",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b3ba88e6-3375-593d-bfbc-c00bd06a6a65",
      "name": "Webhook: restock alert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build the alert text from the RestockPilot payload\nconst p = $input.first().json.body ?? $input.first().json;\nconst lines = (p.lines || []).map(l => `- ${l.sku_name}: ${l.qty} from ${l.supplier_name}, Rs ${Math.round(l.value)} (${l.priority}, ${l.label})`);\nconst blocked = (p.lines || []).some(l => l.label === 'NEVER');\nconst p1 = (p.lines || []).some(l => l.priority === 'P1');\nconst message = `RestockPilot alert for ${p.store}\\nCase ${p.case_id}: ${p.title}\\n${lines.join('\\n')}`;\nconst sms = `RestockPilot ${p.case_id}: ${p1 ? 'stock-out risk (P1). ' : ''}${blocked ? 'An order was BLOCKED. ' : ''}Check Slack/email.`;\nreturn [{ json: { case_id: p.case_id, title: p.title, message, sms, urgent: p1 || blocked, line_count: lines.length } }];"
      },
      "id": "11fe8c5e-848a-50b4-b37f-fe68e99cdd44",
      "name": "Build message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "alerts",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "case_id": "={{ $json.case_id }}",
            "message": "={{ $json.message }}",
            "urgent": "={{ $json.urgent }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "ff66254e-d9f3-5150-8d52-f6623049a4b4",
      "name": "Log alert in Postgres",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        120
      ],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.urgent }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "27fd99a0-e8f2-5728-aa2a-ac605d66ef64",
      "name": "Urgent? (P1 or blocked)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
