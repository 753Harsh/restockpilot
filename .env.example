# Copy this file to .env and fill in your own values. Never commit .env.
LLM_PROVIDER=groq            # groq | ollama | none
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=llama3.1
# Optional: PostgreSQL for the purchase order log (SQLite is used if empty)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/restockpilot
# Optional: n8n webhook for Slack / email / SMS alerts
N8N_WEBHOOK_URL=
